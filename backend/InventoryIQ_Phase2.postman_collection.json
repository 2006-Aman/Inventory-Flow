{
  "info": {
    "_postman_id": "a9840248-b428-4f81-9b7e-908cfbf66092",
    "name": "InventoryIQ - Phase 2 Demand Forecasting & Inventory API",
    "description": "Comprehensive Postman Collection covering Authentication, Product CRUD, Categories, Sales Transactions, Demand Forecasting, and Reorder Point calculations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('authToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Rivera\",\n  \"email\": \"alex.rivera@inventoryflow.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('authToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@inventoryflow.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "List All Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.category && res.category._id) {",
                  "    pm.collectionVariables.set('categoryId', res.category._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart Home\",\n  \"description\": \"IoT devices and smart controllers\",\n  \"status\": \"Active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        },
        {
          "name": "Get Category by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Products",
      "item": [
        {
          "name": "List All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.products && res.products.length > 0) {",
                  "    pm.collectionVariables.set('productId', res.products[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Studio Monitor Speaker\",\n  \"sku\": \"SPK-STUDIO-01\",\n  \"category\": \"Audio & Acoustics\",\n  \"currentStock\": 25,\n  \"leadTimeDays\": 7,\n  \"safetyStock\": 5,\n  \"price\": 149.99,\n  \"costPrice\": 75.00,\n  \"description\": \"Bi-amplified nearfield studio monitor speaker\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Update Product Stock / Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentStock\": 15,\n  \"leadTimeDays\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sales & Inventory Deduction",
      "item": [
        {
          "name": "Log New Sale (Anti-Cheat Stock Decrement)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2,\n  \"sellingPrice\": 129.99,\n  \"paymentMethod\": \"Card\",\n  \"customerName\": \"John Doe\",\n  \"notes\": \"In-store counter checkout\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales"]
            }
          }
        },
        {
          "name": "List Sales History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales"]
            }
          }
        },
        {
          "name": "Sales Statistics & Top Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sales/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Forecast Engine & Reorder Point",
      "item": [
        {
          "name": "Get Forecast Overview & Reorder Alerts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/forecast?forecastDays=7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "forecast"],
              "query": [
                {
                  "key": "forecastDays",
                  "value": "7"
                }
              ]
            }
          }
        },
        {
          "name": "Get Active Reorder Alerts Only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/forecast/alerts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "forecast", "alerts"]
            }
          }
        },
        {
          "name": "Get Single Product Forecast Breakdown",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/forecast/product/{{productId}}?forecastDays=7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "forecast", "product", "{{productId}}"],
              "query": [
                {
                  "key": "forecastDays",
                  "value": "7"
                }
              ]
            }
          }
        },
        {
          "name": "Simulate Forecast (Custom Parameters)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadTimeDays\": 10,\n  \"safetyStock\": 8,\n  \"currentStock\": 14,\n  \"dailySalesHistory\": [4, 6, 5, 8, 7, 5, 6, 9],\n  \"forecastDays\": 14\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forecast/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "forecast", "simulate"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    }
  ]
}
